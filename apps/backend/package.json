{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.json && concurrently -k -n tsc,node \"tsc -w -p tsconfig.json --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start:docker": "tsx src/infrastructure/persistence/drizzle/migrate.ts && tsx src/infrastructure/persistence/drizzle/seed.ts && pnpm run start:dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/persistence/drizzle/migrate.ts",
    "db:seed": "tsx src/infrastructure/persistence/drizzle/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.80.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
