# Backend HTTP port
PORT=3000

# PostgreSQL connection string (self-hosted via Docker Compose — AD-2, no
# managed/paid DB provider).
DATABASE_URL=postgres://geoemploi:geoemploi@localhost:5432/geoemploi

# Contact email sent in the User-Agent header of every OSM tile request
# (infrastructure/mapping/osm-tile-provider.adapter.ts). OSM's tile usage
# policy requires a reachable contact — set this to a real address before
# any non-local/demo use.
OSM_TILE_CONTACT_EMAIL=ministry-demo@localhost
